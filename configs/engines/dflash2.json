{
  "schema": "agentbench/engine/v1",
  "name": "dflash2-f16",
  "description": "First speculation candidate: Hipfire's dflash speculation with a DFlash2 F16 drafter. Identical prompt, identical sampling, identical max_tokens as the AR row -- only the decode path differs. Requires -before-engine to load the drafter and switch the daemon.",
  "endpoint": "http://127.0.0.1:11435/v1",
  "model": "qwen3.8:27b-fast",
  "target_quant": "MQ4R",
  "kv_mode": "Q8",
  "speculation_mode": "dflash",
  "telemetry_adapter": "hipfire",
  "identity_probe": {
    "path": "/health",
    "require": {
      "model": "qwen3.8:27b-fast"
    },
    "record": {
      "version": "engine_commit",
      "model_hash": "model_hash",
      "draft_model": "draft_hash"
    }
  },
  "sampling": {
    "temperature": 0,
    "max_tokens": 12288,
    "thinking": "off",
    "thinking_off_mechanism": "chat_template_kwargs"
  },
  "non_default_knobs": {
    "draft_arch": "DFlash2",
    "draft_precision": "F16"
  }
}
